           backend,\\n+                source,\\n+                &[],\\n+                &[],\\n+                provider.clone(),\\n+                ScriptLimits::default(),\\n+                Cancellation::default(),\\n+            ));\\n+            match outcome {\\n+                RouteOutcome::Executed(out) => {\\n+                    println!(\\\"{backend:?}: {:?}, stdout={:?}\\\", out.status, out.stdout);\\n+                }\\n+                RouteOutcome::Unsupported(error) => {\\n+                    println!(\\\"{backend:?}: Host routing stub only: {error}\\\");\\n+                }\\n+                RouteOutcome::Rejected(error) => println!(\\\"{backend:?}: rejected: {error}\\\"),\\n+            }\\n+            assert_eq!(provider.record_count(), 0);\\n+        }\\n+    }\\n+}\\ndiff --git a/src/frontend.rs b/src/frontend.rs\\nindex e834ea2..1d1b5cd 100644\\n--- a/src/frontend.rs\\n+++ b/src/frontend.rs\\n@@ -14,6 +14,9 @@ fn err(message: impl Into<String>) -> CompileError {\\n fn type_err(message: impl Into<String>) -> CompileError {\\n     CompileError::new(AdmissionKind::Type, message)\\n }\\n+fn resource_err(message: impl Into<String>) -> CompileError {\\n+    CompileError::new(AdmissionKind::...", "duration_ms": 78, "is_error": false, "timestamp": 1792129057165}
