@@ -0,0 +1,279 @@
+//! BY isolated API experiment. Archived with candidate, not a production contract.
+#![cfg(all(feature = "tool-json", not(target_arch = "wasm32")))]
+use minipy_native::{
+    buffer::QuoteBuffer,
+    codegen::CodeUnit,
+    error::TaskError,
+    interpreter::{self, InterpreterUnit},
+    provider::{Provider, ToolDispatch},
+    runtime::{self, Cancellation, ScriptLimits, ScriptOutcome},
+    tool::{ArgumentSchema, Reply, ResultSchema, ToolArguments, ToolDeclaration},
+};
+use std::{
+    alloc::{GlobalAlloc, Layout, System},
+    future::Future,
+    pin::pin,
+    rc::Rc,
+    sync::{
+        Arc,
+        atomic::{AtomicUsize, Ordering},
+    },
+    task::Poll,
+};
+
+struct Counting;
+static ALLOCS: AtomicUsize = AtomicUsize::new(0);
+static BYTES: AtomicUsize = AtomicUsize::new(0);
+unsafe impl GlobalAlloc for Counting {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        ALLOCS.fetch_add(1, Ordering::Relaxed);
+        BYTES.fetch_add(layout.size(), Ordering::Relaxed);
+        unsafe { System.alloc(layout) }
+    }
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        unsafe { System.dealloc(ptr, layout) }
+    }
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, size: usize) -> *mut u8 {
+        ALLOCS.fetch_add(1, Ordering::Relaxed);
+        BYTES.fetch_add(size, Ordering::Relaxed);
+        unsafe { System.realloc(ptr, layout, size) }
+    }
+}
+#[global_allocator]
+static ALLOCATOR: Counting = Counting;
+struct Host {
+    mode: u8,
+    allowed: bool,
+    begin: AtomicUsize,
+    effects: AtomicUsize,
+    deferred: AtomicUsize,
+    cancel: Cancellation,
+}
+impl Host {
+    fn new(mode: u8) -> Arc<Self> {
+        Arc::new(Self {
+            mode,
+            allowed: true,
+            begin: AtomicUsize::new(0),
+            effects: AtomicUsize::new(0),
+            deferred: AtomicUsize::new(0),
+            cancel: Cancellation::default(),
+        })
+    }
+    fn effect(&self, args: ToolArguments) -> Result<Reply, TaskError> {
+        self.effects.fetch_add(1, Ordering::SeqCst);
+        assert!(matches!(args, ToolArguments::Numeric([7, _], 1)));
+        match self.mode {
+            2 => Err(TaskError::Provider("failed".into())),
+            3 => panic!("provider panic"),
+            4 => {
+                self.cancel.cancel();
+                Ok(Reply::I64(42))
+            }
+            5 => Ok(Reply::Json(bytes::Bytes::from_static(b"{}"))),
+            _ => Ok(Reply::I64(42)),
+        }
+    }
+}
+impl Provider for Host {
+    fn allows_tool(&self, _: u32) -> bool {
+        self.allowed
+    }
+    fn begin_tool(&self, _: u32, args: ToolArguments) -> ToolDispatch {
+        self.begin.fetch_add(1, Ordering::SeqCst);
+        if self.mode == 0 {
+            ToolDispatch::Deferred(args)
+        } else {
+            ToolDispatch::Ready(self.effect(args))
+        }
+    }
+    async fn call_bound_tool(&self, _: u32, args: ToolArguments) -> Result<Reply, TaskError> {
+        self.deferred.fetch_add(1, Ordering::SeqCst);
+        self.effect(args)
+    }
+    async fn load_quotes(&self, _: i64) -> Result<QuoteBuffer, TaskError> {
+        Err(TaskError::Permission)
+    }
+    async fn record_total(&self, _: i64, _: i64) -> Result<i64, TaskError> {
+        Err(TaskError::Permission)
+    }
+}
+fn tools() -> Vec<ToolDeclaration> {
+    vec![ToolDeclaration {
+        id: 2,
+        name: "metric".into(),
+        arguments: vec![ArgumentSchema::I64("value".into())],
+        result: ResultSchema::I64,
+    }]
+}
+async fn run(native: bool, src: &str, host: Arc<Host>, limits: ScriptLimits) -> ScriptOutcome {
+    let cancel = host.cancel.clone();
+    if native {
+        runtime::execute_script(
+            Rc::new(CodeUnit::compile_with_declarations(src, &[], &tools()).unwrap()),
+            host,
+            &[],
+            limits,
+            cancel,
+            None,
+        )
+        .await
+    } else {
+        interpreter::execute_script(
+            Rc::new(InterpreterUnit::prepare_with_declarations(src, &[], &tools()).unwrap()),
+            host,
+            &[],
+            limits,
+            cancel,
+            None,
+        )
+        .await
+    }
+}
+#[tokio::test]
+async fn ready_errors_cancellation_and_effects_are_once() {
+    for native in [false, true] {
+        for mode in 0..=5 {
+            let host = Host::new(mode);
+            let out = run(
+                native,
+                "print(1)\nprint(tools.metric(7))\nprint(2)",
+                host.clone(),
+                ScriptLimits::default(),
+            )
+            .await;
+            let expected = match mode {
+                2 => Err(TaskError::Provider("failed".into())),
+                3 => Err(TaskError::Provider("operation lost".into())),
+                4 => Err(TaskError::Cancelled),
+                5 => Err(TaskError::Json("Tool reply does not match declaration")),
+                _ => Ok(()),
+            };
+            assert_eq!(out.status, expected);
+            assert_eq!(out.stdout, if mode <= 1 { "1\n42\n2\n" } else { "1\n" });
+            assert_eq!(host.effects.load(Ordering::SeqCst), 1);
+            assert_eq!(host.deferred.load(Ordering::SeqCst), usize::from(mode == 0));
+        }
+    }
+}
+#[tokio::test]
+async fn no_dispatch_before_authority_budget_or_entry_cancel() {
+    for native in [false, true] {
+        for case in 0..3 {
+            let mut host = Host::new(1);
+            if case == 0 {
+                Arc::get_mut(&mut host).unwrap().allowed = false;
+            }
+            let mut limits = ScriptLimits::default();
+            if case == 1 {
+                limits.tool_calls = 0;
+            }
+            if case == 2 {
+                host.cancel.cancel();
+            }
+            let out = run(native, "print(tools.metric(7))", host.clone(), limits).await;
+            assert_eq!(
+                out.status,
+                Err(match case {
+                    0 => TaskError::Permission,
+                    1 => TaskError::Budget,
+                    _ => TaskError::Cancelled,
+                })
+            );
+            assert_eq!(host.begin.load(Ordering::SeqCst), 0);
+            assert_eq!(host.effects.load(Ordering::SeqCst), 0);
+        }
+    }
+}
+#[tokio::test]
+async fn ready_chain_yields_each_call_and_cancel_does_not_repeat_effect() {
+    for native in [false, true] {
+        let host = Host::new(1);
+        let src = "print(tools.metric(7))\n".repeat(8);
+        let mut future = pin!(run(native, &src, host.clone(), ScriptLimits::default()));
+        std::future::poll_fn(|cx| {
+            assert!(future.as_mut().poll(cx).is_pending());
+            assert_eq!(host.effects.load(Ordering::SeqCst), 1);
+            Poll::Ready(())
+        })
+        .await;
+        // A sibling runs between turns; cancellation must win over the completed reply.
+        let h = host.clone();
+        tokio::spawn(async move {
+            h.cancel.cancel();
+        })
+        .await
+        .unwrap();
+        let out = future.await;
+        assert_eq!(out.status, Err(TaskError::Cancelled));
+        assert!(out.stdout.is_empty());
+        assert_eq!(host.effects.load(Ordering::SeqCst), 1);
+    }
+}
+#[test]
+#[ignore = "separate allocator/future diagnostic under shared perf lock"]
+fn by_diagnostic() {
+    let rt = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .unwrap();
+    for native in [false, true] {
+        for mode in [0, 1] {
+            let host = Host::new(mode);
+            let source = "print(tools.metric(7))";
+            let native_code = native.then(|| {
+                Rc::new(CodeUnit::compile_with_declarations(source, &[], &tools()).unwrap())
+            });
+            let tape_code = (!native).then(|| {
+                Rc::new(InterpreterUnit::prepare_with_declarations(source, &[], &tools()).unwrap())
+            });
+            for sample in 0..5 {
+                let cancel = Cancellation::default();
+                let (out, size, count, bytes) = if native {
+                    let future = runtime::execute_script(
+                        native_code.as_ref().unwrap().clone(),
+                        host.clone(),
+                        &[],
+                        ScriptLimits::default(),
+                        cancel,
+                        None,
+                    );
+                    let size = std::mem::size_of_val(&future);
+                    let a = ALLOCS.load(Ordering::Relaxed);
+                    let b = BYTES.load(Ordering::Relaxed);
+                    let out = rt.block_on(future);
+                    (
+                        out,
+                        size,
+                        ALLOCS.load(Ordering::Relaxed) - a,
+                        BYTES.load(Ordering::Relaxed) - b,
+                    )
+                } else {
+                    let future = interpreter::execute_script(
+                        tape_code.as_ref().unwrap().clone(),
+                        host.clone(),
+                        &[],
+                        ScriptLimits::default(),
+                        cancel,
+                        None,
+                    );
+                    let size = std::mem::size_of_val(&future);
+                    let a = ALLOCS.load(Ordering::Relaxed);
+                    let b = BYTES.load(Ordering::Relaxed);
+                    let out = rt.block_on(future);
+                    (
+                        out,
+                        size,
+                        ALLOCS.load(Ordering::Relaxed) - a,
+                        BYTES.load(Ordering::Relaxed) - b,
+                    )
+                };
+                assert_eq!(out.status, Ok(()));
+                assert_eq!(out.stdout, "42\n");
+                println!(
+                    "BY {{\"native\":{native},\"mode\":{mode},\"sample\":{sample},\"future_bytes\":{size},\"allocations\":{count},\"requested_bytes\":{bytes}}}"
+                );
+            }
+        }
+    }
+}
