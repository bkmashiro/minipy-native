+/// BY isolated experiment: explicit completion only, never poll an async future inline.
+#[cfg(all(feature = "tool-json", not(target_arch = "wasm32")))]
+pub(crate) async fn dispatch_tool<P: Provider>(
+    provider: Arc<P>,
+    id: u32,
+    argument: crate::tool::ToolArguments,
+    cancel: &Cancellation,
+) -> Result<crate::tool::Reply, TaskError> {
+    use crate::provider::ToolDispatch;
+    let dispatch = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        provider.begin_tool(id, argument)
+    }));
+    match dispatch {
+        Ok(ToolDispatch::Deferred(argument)) => {
+            let (tx, rx) = oneshot::channel();
+            tokio::spawn(async move {
+                let _ = tx.send(provider.call_bound_tool(id, argument).await);
+            });
+            receive(rx, cancel).await
+        }
+        ready => {
+            // Preserve a scheduling/cancellation boundary even for chains of Ready calls.
+            // No provider future, parameter lease or permit may remain pending here.
+            tokio::task::yield_now().await;
+            check(cancel)?;
+            match ready {
+                Ok(ToolDispatch::Ready(result)) => result,
+                Err(_) => Err(TaskError::Provider("operation lost".into())),
+                _ => unreachable!(),
+            }
+        }
+    }
+}
