+#[test]
+fn count_chunk_matches_sequential_partial_progress() {
+    fn check<const QUANTITY: bool>() {
+        let values = [i64::MIN, -7, -1, 0, 1, 9, i64::MAX];
+        let rows: Vec<_> = (0..4100)
+            .map(|i| Quote {
+                unit_price_cents: values[i % values.len()],
+                quantity: values[(i * 3 + 2) % values.len()],
+            })
+            .collect();
+        for length in (0..=33).chain([255, 256, 257, 4095, 4096]) {
+            for offset in 0..4 {
+                let rows = &rows[offset..offset + length];
+                for threshold in [i64::MIN, -1, 0, 9, i64::MAX] {
+                    for initial in [
+                        i64::MIN,
+                        -5,
+                        0,
+                        i64::MAX - length as i64,
+                        i64::MAX - 9,
+                        i64::MAX - 1,
+                        i64::MAX,
+                    ] {
+                        let mut expected = initial;
+                        let mut result = Ok(());
+                        for (i, row) in rows.iter().enumerate() {
+                            let value = if QUANTITY {
+                                row.quantity
+                            } else {
+                                row.unit_price_cents
+                            };
+                            if value > threshold {
+                                match expected.checked_add(1) {
+                                    Some(next) => expected = next,
+                                    None => {
+                                        result = Err(i);
+                                        break;
+                                    }
+                                }
+                            }
+                        }
+                        let mut actual = initial;
+                        assert_eq!(
+                            count_chunk::<QUANTITY>(rows, threshold, &mut actual),
+                            result
+                        );
+                        assert_eq!(actual, expected);
+                    }
+                }
+            }
+        }
+    }
+    check::<false>();
+    check::<true>();
+}
